# CDC Badge Updater - minimal sdkconfig

# Main task stack
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_FREERTOS_HZ=1000

# Flash configuration
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHSIZE_DETECT=n

# PSRAM (SPIRAM) configuration
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Serial console via ESP32-S3 built-in USB-Serial-JTAG (ROM CDC, no TinyUSB
# needed). The badge has no external UART bridge, so UART0 alone would not
# be reachable. The primary-console Kconfig "choice" requires the default
# (UART) to be turned off explicitly before USJ can take its place.
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED=y

# Compile-time stripped to INFO so ESP-IDF spi_master / bus_lock VERBOSE/DEBUG
# noise is removed entirely from the binary. esp_log_level_set() at runtime
# can no longer raise individual tags above INFO with this setting.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y

# Brownout detector enabled at highest sensitivity
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_7=y

# Connectivity stacks explicitly OFF
CONFIG_BT_ENABLED=n
CONFIG_ESP_WIFI_ENABLED=n
CONFIG_OPENTHREAD_ENABLED=n
CONFIG_IEEE802154_ENABLED=n
CONFIG_ETH_USE_SPI_ETHERNET=n
CONFIG_ETH_USE_OPENETH=n
CONFIG_ETH_USE_ESP32_EMAC=n

# mbedtls: keep only AES, GCM, SHA256, HMAC, HKDF, X25519 (Everest)
CONFIG_MBEDTLS_TLS_SERVER_AND_CLIENT=n
CONFIG_MBEDTLS_TLS_SERVER_ONLY=n
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=n
CONFIG_MBEDTLS_TLS_DISABLED=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=n
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=n
CONFIG_MBEDTLS_SSL_PROTO_DTLS=n
CONFIG_WPA_MBEDTLS_TLS_CLIENT=n
CONFIG_WPA_WAPI_PSK=n
CONFIG_ESP_WIFI_MBEDTLS_TLS_CLIENT=n
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
CONFIG_MBEDTLS_HAVE_TIME=n
CONFIG_MBEDTLS_HAVE_TIME_DATE=n
CONFIG_MBEDTLS_PEM_PARSE_C=n
CONFIG_MBEDTLS_PEM_WRITE_C=n
CONFIG_MBEDTLS_X509_USE_C=n
CONFIG_MBEDTLS_X509_CRT_PARSE_C=n
CONFIG_MBEDTLS_X509_CRL_PARSE_C=n
CONFIG_MBEDTLS_X509_CSR_PARSE_C=n
CONFIG_MBEDTLS_PSA_CRYPTO_C=n
CONFIG_MBEDTLS_RSA_C=n
CONFIG_MBEDTLS_ECDH_C=n
CONFIG_MBEDTLS_ECDSA_C=n
CONFIG_MBEDTLS_ECP_C=n
CONFIG_MBEDTLS_ECJPAKE_C=n
CONFIG_MBEDTLS_DHM_C=n
CONFIG_MBEDTLS_CHACHA20_C=n
CONFIG_MBEDTLS_CHACHAPOLY_C=n
CONFIG_MBEDTLS_POLY1305_C=n
CONFIG_MBEDTLS_CAMELLIA_C=n
CONFIG_MBEDTLS_ARIA_C=n
CONFIG_MBEDTLS_DES_C=n
CONFIG_MBEDTLS_BLOWFISH_C=n
CONFIG_MBEDTLS_XTEA_C=n
CONFIG_MBEDTLS_CMAC_C=n
CONFIG_MBEDTLS_CCM_C=n
CONFIG_MBEDTLS_NIST_KW_C=n
CONFIG_MBEDTLS_LMS_C=n
CONFIG_MBEDTLS_PKCS5_C=n
CONFIG_MBEDTLS_PKCS12_C=n
CONFIG_MBEDTLS_RIPEMD160_C=n
CONFIG_MBEDTLS_SHA512_C=n
CONFIG_MBEDTLS_SHA3_C=n
CONFIG_MBEDTLS_THREADING_C=n
CONFIG_MBEDTLS_DEBUG=n
CONFIG_MBEDTLS_ERROR_STRINGS=n

# Disable lwip extras and PPP (no networking required at all)
CONFIG_LWIP_PPP_SUPPORT=n
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_NETIF_LOOPBACK=n
CONFIG_LWIP_DHCPS=n
CONFIG_LWIP_DHCP_CLIENT=n
CONFIG_LWIP_AUTOIP=n
CONFIG_LWIP_NETIF_API=n
CONFIG_LWIP_SOCKET_MULTITHREAD=n

# mbedtls hardware acceleration off (libtropic patch disables GCM HW path)
CONFIG_MBEDTLS_HARDWARE_GCM=n
CONFIG_MBEDTLS_HARDWARE_MPI=n

# esp-tls and HTTPS subsystems are unreachable without networking
CONFIG_ESP_TLS_SERVER=n
CONFIG_ESP_TLS_PSK_VERIFICATION=n
CONFIG_ESP_TLS_INSECURE=n

# Power management, profiling, tracing
CONFIG_PM_ENABLE=n
CONFIG_PM_PROFILING=n
CONFIG_PM_TRACE=n
CONFIG_FREERTOS_USE_TRACE_FACILITY=n
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=n
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=n

# VFS: only console IO required, no filesystems, no select, no termios
CONFIG_VFS_SUPPORT_DIR=n
CONFIG_VFS_SUPPORT_SELECT=n
CONFIG_VFS_SUPPORT_TERMIOS=n

# Heap: production settings, no poisoning or tracing
CONFIG_HEAP_POISONING_DISABLED=y
CONFIG_HEAP_TRACING_OFF=y

# Newlib: nano printf
CONFIG_NEWLIB_NANO_FORMAT=y

# Bootloader slimming
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=n
CONFIG_BOOTLOADER_FACTORY_RESET=n

# Other unused subsystems
CONFIG_PERFMON_ENABLE=n
CONFIG_ESP_GDBSTUB_ENABLED=n
CONFIG_ESP_HTTPS_OTA_DECRYPT_CB=n
CONFIG_ULP_COPROC_ENABLED=n
CONFIG_USB_OTG_SUPPORTED=n
CONFIG_USB_HOST_HUBS_SUPPORTED=n

# Compiler: optimise for size
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_HIDE_PATHS_MACROS=y

# Core dump to flash for crash analysis
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y

# E-Paper Display Pins (GDEY029T94, same as CDC Badge OS)
CONFIG_EINK_SPI_MOSI=13
CONFIG_EINK_SPI_CLK=12
CONFIG_EINK_SPI_CS=41
CONFIG_EINK_DC=45
CONFIG_EINK_RST=46
CONFIG_EINK_BUSY=42
CONFIG_EINK_SPI_MISO=11
